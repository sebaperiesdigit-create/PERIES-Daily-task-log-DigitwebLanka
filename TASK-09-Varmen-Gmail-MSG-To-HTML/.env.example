# Template only - copy this file to .env and fill in real values there.
# .env is gitignored and NEVER committed. src/db.js reads these. See
# docs/HANDOVER.md and the plan at
# C:\Users\LED 269\.claude\plans\flickering-beaming-brooks.md.

VARMEN_DB_HOST=
VARMEN_DB_PORT=
VARMEN_DB_NAME=
VARMEN_DB_USER=
VARMEN_DB_PASSWORD=

# Mandatory identity gate (src/db.js verifyIdentity) - checked internally
# before every write via `SELECT current_database(), current_user;`, pass/
# fail only, raw result never printed. Deliberately separate from the
# connection params above: a correct connection to the wrong database/user
# would otherwise succeed silently. Missing either value = automatic fail.
VARMEN_EXPECTED_DB=
VARMEN_EXPECTED_USER=

# OFF BY DEFAULT (added 2026-09-04). Set to the literal string "true" to
# make `node --env-file=.env src/run-live.js` ALSO mirror records into
# welfare.loan_requests, in parallel with the JSON store - see
# src/pg-store.js and src/run-live.js. Leave unset/blank and the live
# pipeline never touches Varmen DB, exactly as before this flag existed.
VARMEN_DB_MIRROR=

# Defaults to 30 (days) if unset/blank - see src/gmail-fetch.js. Set to the
# literal string "all" (added 2026-09-04) to search the FULL mailbox
# history with no date bound - real evidence showed several genuine loan
# requests, months old, were silently missing from every run because they
# fell outside the default 30-day window. Use "all" ONLY together with
# FORCE_BACKFILL=true below for a one-time historical catch-up, then set
# this back to a normal rolling window (e.g. 30) for ongoing runs.
GMAIL_FETCH_SINCE_DAYS=

# OFF BY DEFAULT (added 2026-09-04). Set to the literal string "true" to
# force this run to be treated as a historical backfill (no acknowledgement
# drafts, even for otherwise-complete requests) REGARDLESS of whether
# data/live/store.json already exists - see src/run-live.js. Needed for a
# one-time wide catch-up (with GMAIL_FETCH_SINCE_DAYS=all above) so newly-
# appearing old requests don't get acknowledgement drafts just because the
# store already exists from earlier normal runs.
FORCE_BACKFILL=
